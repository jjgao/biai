# BIAI Production Environment Configuration
# Copy this file to .env.production and customize values

# ===================================
# Database Configuration
# ===================================
CLICKHOUSE_DATABASE=biai
CLICKHOUSE_USER=biai
# IMPORTANT: Change this password in production!
CLICKHOUSE_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ===================================
# Server Configuration  
# ===================================
NODE_ENV=production
PORT=5001
LOG_LEVEL=info

# ===================================
# Client Configuration
# ===================================
# Port to expose the application (default: 80)
CLIENT_PORT=80
