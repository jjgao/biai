# BIAI Production Environment Configuration
# Copy this file to .env.production and customize values

# ===================================
# Database Configuration
# ===================================
CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_DATABASE=biai

# ===================================
# Server Configuration  
# ===================================
NODE_ENV=production
PORT=5001
LOG_LEVEL=info

# ===================================
# Client Configuration
# ===================================
# The API URL is configured in nginx.conf (proxy_pass)
# No client-side environment variables needed for production
